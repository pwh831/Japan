{
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0"
  },
  "name": "japanese-exam",
  "private": true,
  "description": "일본어 시험 대비 — 단어·표현·동사 활용",
  "scripts": {
    "build": "python3 build.py",
    "test": "python3 tools/extract-engine.py > /tmp/engine.js && node tools/test-engine.js /tmp/engine.js && node tools/check-sets.js",
    "smoke": "python3 build.py && node tools/smoke.js",
    "pdf": "python3 tools/annotate-pdf.py",
    "script-pdf": "python3 tools/script-pdf.py",
    "studio": "python3 tools/build-studio.py --fonts && node tools/studio-check.js",
    "sets": "node tools/check-sets.js && python3 tools/sets-pdf.py",
    "pdf2": "python3 tools/annotate-pdf.py docs/2026-일본어회화-2학기2회고사-단어장.pdf docs/2026-일본어회화-2학기2회고사-단어장-발음.pdf",
    "book": "python3 tools/book-pdf.py"
  }
}
